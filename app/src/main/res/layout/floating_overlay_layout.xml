<?xml version="1.0" encoding="utf-8"?>
<!-- ChatGPT-style floating overlay layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_container"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Pulse ring (animates when recording) -->
    <View
        android:id="@+id/pulse_ring"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/recording_pulse_ring"
        android:alpha="0"
        android:visibility="gone" />

    <!-- Main mic button - rounded square -->
    <ImageButton
        android:id="@+id/btn_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_mic_white"
        android:background="@drawable/mic_button_background"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:elevation="4dp"
        android:contentDescription="@string/record_button" />

    <!-- Progress indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorOutline"
        app:indicatorSize="32dp"
        android:visibility="gone" />


</FrameLayout>
